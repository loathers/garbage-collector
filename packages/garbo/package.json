{
  "name": "garbo",
  "version": "1.0.0",
  "description": "Script for farming meat (and garbage) in 2004 web RPG Kingdom of Loathing.",
  "repository": "https://github.com/loathers/garbage-collector.git",
  "main": "dist/scripts/garbage-collector/garbo.js",
  "type": "module",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "build": "rollup -c rollup.config.ts && yarn run copyStatic",
    "watch": "rollup -c rollup.config.ts --watch",
    "copyStatic": "copyfiles --up 1 \"static/**/*\" dist",
    "check": "tsc",
    "lint": "eslint src && prettier --check .",
    "format": "eslint src --fix && prettier --write .",
    "madge": "madge --circular . ./src/index.ts",
    "pre-commit": "lint-staged"
  },
  "lint-staged": {
    "src/**/*.{js,jsx,ts,tsx,json,css}": [
      "eslint --quiet --fix",
      "prettier --write"
    ],
    "**/*.{json,md,html,yml}": [
      "prettier --write --ignore-unknown"
    ]
  },
  "author": "",
  "license": "MIT",
  "dependencies": {
    "garbo-lib": "workspace:*",
    "grimoire-kolmafia": "^0.3.35",
    "kolmafia": "^5.28673.0",
    "libram": "^0.11.29"
  },
  "devDependencies": {
    "@babel/cli": "^7.29.7",
    "@babel/compat-data": "^7.29.7",
    "@babel/core": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@rollup/plugin-babel": "^7.1.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^22.4.1",
    "copyfiles": "^2.4.1",
    "eslint": "^9.39.2",
    "eslint-config-garbo": "workspace:^",
    "jiti": "^2.6.1",
    "lint-staged": "^15.2.9",
    "madge": "^8.0.0",
    "prettier": "^3.3.3",
    "rollup": "^4.63.1",
    "typescript": "^5.5.4"
  }
}
