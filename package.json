{
  "name": "garbage-collector",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "yarn workspaces foreach -ptv run build && yarn run combineFiles",
    "check": "yarn checkTools && yarn workspaces foreach -pv run check",
    "combineFiles": "copyfiles --up 2 \"packages/garbo/dist/**\" .; copyfiles --up 2 \"packages/garbo-relay/dist/**\" .; copyfiles --up 2 \"packages/garbo-choice/dist/**\" .",
    "format": "yarn run prettier --write .github tools && yarn workspaces foreach -pv run format",
    "lint": "yarn prettier --check tools && yarn workspaces foreach -pv run lint",
    "pre-commit": "yarn workspaces foreach -v run pre-commit",
    "madge": "yarn workspaces foreach -v run madge",
    "updateSocp": "node tools/updateSocp.mts",
    "testSocp": "node --test --test-isolation=none tools/updateSocp.test.mts",
    "checkTools": "tsc -p tools/tsconfig.json",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/node": "^22.4.1",
    "copyfiles": "^2.4.1",
    "data-of-loathing": "^4.3.2",
    "entities": "^7.0.0",
    "eslint": "^9.39.2",
    "husky": "^9.1.5",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.50.0"
  },
  "packageManager": "yarn@3.6.4"
}
